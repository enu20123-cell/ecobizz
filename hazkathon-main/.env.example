# Copy this file to .env and fill in your own keys.
# Never commit the real .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Telegram bot (bot.py) — get a token from @BotFather. BACKEND_URL only
# needs changing if the FastAPI backend runs somewhere other than localhost.
TELEGRAM_BOT_TOKEN=
# Bot's public @username (no @, no token) — shown as an "Open in Telegram"
# link on the dashboard. Safe to commit; it's public info, not a secret.
TELEGRAM_BOT_USERNAME=
BACKEND_URL=http://127.0.0.1:8000
